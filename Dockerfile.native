FROM ghcr.io/graalvm/native-image-community:25-ol9 AS builder
WORKDIR /workspace/app
RUN microdnf install -y findutils tar gzip sed freetype-devel fontconfig-devel \
        libX11-devel libXext-devel libXrender-devel libXi-devel libXtst-devel \
    && microdnf clean all
COPY .mvn .mvn
COPY mvnw pom.xml lombok.config ./
COPY src/main src/main
ARG NATIVE_SPRING_PROFILES=h2,container
RUN sed -i 's/\r$//' mvnw && chmod +x mvnw
RUN --mount=type=cache,target=/root/.m2 ./mvnw -B -Pnative -DskipTests \
    -Dnative.spring.profiles=${NATIVE_SPRING_PROFILES} package
RUN mkdir -p /workspace/native \
    && cp target/moliapi /workspace/native/ \
    && find target -maxdepth 1 -type f -name '*.so' -exec cp '{}' /workspace/native/ \;

FROM oraclelinux:9-slim
RUN microdnf install -y ca-certificates freetype fontconfig dejavu-sans-fonts \
        libX11 libXext libXrender libXi libXtst zlib \
    && microdnf clean all \
    && mkdir -p /soft/.api/config /soft/.cache /tmp \
    && chown -R 10001:10001 /soft
WORKDIR /soft
COPY --chown=10001:10001 --from=builder /workspace/native/ ./
ENV MOLI_PATH=/soft/.api/ \
    HOME=/soft \
    XDG_CACHE_HOME=/soft/.cache \
    LD_LIBRARY_PATH=/soft \
    SPRING_PROFILES_ACTIVE=h2,container \
    SPRING_CONFIG_ADDITIONAL_LOCATION=optional:file:/soft/.api/config/
USER 10001:10001
EXPOSE 8090
VOLUME /soft/.api
ENTRYPOINT ["/soft/moliapi"]
